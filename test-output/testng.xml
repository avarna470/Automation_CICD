<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite" parallel="tests" thread-count="7">
	
	<listeners>
		<listener class-name="day_course.Listeners_Code"/>
	</listeners>
	
	<test thread-count="5" name="Personal Loan" parallel="classes">
		<parameter name="URL" value="personalloan.com"/>
		<classes>
			<class name="day_course.Basic_Test" />
			<class name="day_course.Sample_Test" />
			<class name="day_course.Test4">
				<methods>
					<exclude name="apiLoginHomeLoan" />
				</methods>
			</class>
		</classes>
	</test> <!--
	Test -->

	<test name="Car Loan">
		<parameter name="URL" value="carloan.com"/>
		<classes>
			<class name="day_course.Test3">
				<methods>
					<exclude name="api.*" />
				</methods>

			</class>
		</classes>
	</test>


</suite> <!--
Suite -->
